PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/campus-marketplace
USE_MEMORY_DB=auto
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_PEPPER=
OTP_TTL_MS=600000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=60000
DEV_RETURN_OTP=true
ALLOWED_COLLEGE_DOMAINS=campus.edu,thapar.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shwetagarwal121@gmail.com
SMTP_PASS=
SMTP_FROM=shwetagarwal121@gmail.com
ML_SERVICE_URL=http://127.0.0.1:8000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_MODE=dev
PAYMENT_DEV_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SEED_PASSWORD=CampusDemo123!
SEED_ADMIN_PASSWORD=CampusAdmin123!
LOCATION_STALE_MS=604800000

# ── Cloud image storage (Cloudinary: https://cloudinary.com → free tier) ──
# Either one URL …
CLOUDINARY_URL=
# … or the three parts. Leave all empty to use local-disk dev storage (server/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campus-marketplace
# local | cloud (auto = cloud when Cloudinary is configured)
STORAGE_PROVIDER=
MAX_IMAGE_MB=5
# Public base URL of this API, only needed for local storage behind a different host
PUBLIC_API_URL=

# ── Payments ──
# Razorpay Dashboard → Webhooks → https://<your-api>/api/payments/webhook (events: payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=
# minutes an item stays reserved for a buyer while they check out
PAYMENT_RESERVATION_MINUTES=15

# fraud / privacy (optional)
LOCATION_ENC_KEY=
MAX_ACCOUNTS_PER_DEVICE=3
PRICE_DROP_EMAILS=false
